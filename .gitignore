# Python virtual environments (recreate with: python -m venv gaze_env && pip install -r requirements.txt)
gaze-detection/gaze_env/
# 333 MB. Python's venv self-ignores, but do not rely on that surviving a move.
# The gesture module runs from gaze_env anyway — it needs no separate install.
gesture-control-module/.venv/

# Python caches
__pycache__/
*.pyc
*.pyo
*.pyd

# OS / archive junk
.DS_Store
Thumbs.db
**/__MACOSX/
*.zip

# Claude / editor local
.claude/
**/.claude/
CLAUDE.md

# Model weights (91 MB each) — kept out of git; see gaze-detection/SETUP_INSTRUCTIONS.md
gaze-detection/models/l2cs_gaze360.onnx
gaze-detection/models/L2CSNet_gaze360.pkl
gaze-detection/face_landmarker.task
# The hand model (~7 MB) downloads itself on first run — same convention as the
# face landmarker above, so a clone stays small.
gesture-control-module/models/hand_landmarker.task

# Per-person calibration — valid only for the eyes, laptop and seating position
# that recorded it. Each player generates their own with milestone4_calibration.py
# (README step 8), so shipping one is useless to everybody else.
gaze-detection/models/calibration_model.pkl
gaze-detection/models/camera_focal.json

# Editors
.vscode/
.idea/

# Temp
*.tmp
*.log
